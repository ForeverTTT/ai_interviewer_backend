PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_PRACTICE_MODEL=gemini-3.5-flash-lite
# Used for one retry when gemini-3.7-flash returns a quota/rate-limit error.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Legacy English voice setting; language-specific settings take precedence.
GEMINI_LIVE_VOICE=Kore
# Optional language-specific live voices.
# GEMINI_LIVE_VOICE_EN=Kore
# GEMINI_LIVE_VOICE_DE=Despina
# GEMINI_LIVE_VOICE_ZH=Achird
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

# Optional TTS tuning. Voice defaults are selected from interviewer style + language;
# setting a language-specific value below overrides that selection for every style.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE_EN=Sulafat
# GEMINI_TTS_VOICE_DE=Despina
# GEMINI_TTS_VOICE_ZH=Achird
