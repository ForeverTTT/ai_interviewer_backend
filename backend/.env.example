PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Comma-separated; production: https://global.flowlab-career.com,https://aiinterviewer-491711-7b1cf.web.app
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_PRACTICE_MODEL=gemini-3.5-flash-lite
# Used for one retry when gemini-3.7-flash returns a quota/rate-limit error.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Legacy English voice setting; language-specific settings take precedence.
GEMINI_LIVE_VOICE=Kore
# Optional language-specific live voices.
# GEMINI_LIVE_VOICE_EN=Kore
# GEMINI_LIVE_VOICE_DE=Despina
# GEMINI_LIVE_VOICE_ZH=Achird
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

# Enables creation of email reminder outbox rows. An external delivery worker
# must claim pending growth_offer_reminders rows and send them through a provider.
GROWTH_REMINDER_EMAIL_OUTBOX_ENABLED=false

# Comma-separated emails that can open /admin/experiences and approve or reject
# experiences submitted to the library. The account's email must be confirmed.
ADMIN_EMAILS=

# Optional TTS tuning. Voice defaults are selected from interviewer style + language;
# setting a language-specific value below overrides that selection for every style.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Optional comma-separated API key pool for TTS quota rotation.
# GEMINI_TTS_KEYS=key-one,key-two
# GEMINI_TTS_VOICE_EN=Sulafat
# GEMINI_TTS_VOICE_DE=Despina
# GEMINI_TTS_VOICE_ZH=Achird

# Optional Vertex AI fallback. GCP_PROJECT_ID takes precedence over
# GOOGLE_CLOUD_PROJECT; Application Default Credentials must be available.
# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCP_LOCATION=us-central1
# GCP_MODEL=gemini-3.7-flash
# GCP_TTS_VOICE_TIER=Studio

# Daily job board sync from Feishu bitable (scripts/syncFeishuJobs.js, run by
# .github/workflows/sync-feishu-jobs.yml). The app needs bitable read access and
# must be added to the base via "... > Add document app".
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# FEISHU_JOBS_URL=https://xxx.feishu.cn/base/<app_token>?table=<table_id>
