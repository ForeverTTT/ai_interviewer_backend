VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API. VITE_API_URL takes precedence when both values are set.
VITE_BACKEND_URL=http://localhost:5000
# VITE_API_URL=https://your-production-api.example.com

# Local Supabase development (use only with `supabase start`)
# VITE_LOCAL_SUPABASE=true
# VITE_LOCAL_EMAIL=local@example.com
# VITE_LOCAL_PASSWORD=localdev123

# Optional full-body Ready Player Me models for the interviewer avatar.
# Leave unset to use the built-in 3D model with an SVG fallback.
# VITE_RPM_AVATAR_EN=https://models.readyplayer.me/example-en.glb?morphTargets=...
# VITE_RPM_AVATAR_DE=https://models.readyplayer.me/example-de.glb?morphTargets=...
